# Neon Free pooled runtime URL; never commit real credentials.
DATABASE_URL=
# Neon direct URL for migration commands only.
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a verified sender and a Resend Free key. Never auto-enable billing.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated addresses. Promotion requires a verified email, not just a match.
ADMIN_EMAILS=
PUBLIC_APP_NAME=Debit & Credit
# Local integration tests ONLY: postgres selects the official pg adapter.
DATABASE_DRIVER=neon
