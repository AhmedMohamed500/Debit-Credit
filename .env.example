# PostgreSQL runtime URL (Neon or Prisma Postgres); never commit credentials.
DATABASE_URL=
# Optional direct PostgreSQL URL for migration commands only.
# For a pooled Neon DATABASE_URL, use its unpooled URL here for migrations.
# prisma.config.ts falls back to DATABASE_URL when DIRECT_URL is absent.
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a verified sender and a Resend Free key. Never auto-enable billing.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated addresses. Promotion requires a verified email, not just a match.
ADMIN_EMAILS=
PUBLIC_APP_NAME=Debit & Credit
# Use postgres for Prisma Postgres/TCP or local tests; neon for Neon WebSocket.
DATABASE_DRIVER=neon
