{
  "name": "debit-credit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "prebuild": "npm run db:generate",
    "postinstall": "npm run db:generate",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:preflight": "node --conditions=react-server --import tsx scripts/backend-auth-preflight.mjs",
    "dev:backend-test": "node scripts/backend-test-database.mjs",
    "test:backend-api": "node scripts/backend-api-qa.mjs",
    "test:backend-schema": "node scripts/backend-schema-qa.mjs",
    "test:backend-browser": "node scripts/backend-browser-qa.mjs",
    "test:auth-routes": "node scripts/auth-route-smoke.mjs",
    "test:auth-browser": "node scripts/auth-routing-browser-qa.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --maxWorkers=2",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "lucide-react": "^0.542.0",
    "next": "^16.3.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
